# Credenciais LOCAIS do plugin FullBPO.
# Copie para ~/.fullbpo/credenciais.env e rode: chmod 600 ~/.fullbpo/credenciais.env
# NUNCA versione este arquivo preenchido — só nomes/exemplos moram aqui.

# ── FinOps (engine Omie multi-tenant) ──
FINOPS_EMAIL=voce@fullbpo.com
FINOPS_PASSWORD=sua-senha-do-finops

# ── D4Sign (assinatura de contratos — conta única FullBPO) ──
# Gere tokenAPI e cryptKey no painel D4Sign → Configurações → API/Integrações.
D4SIGN_TOKEN_API=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
D4SIGN_CRYPT_KEY=live_crypt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
D4SIGN_BASE_URL=https://secure.d4sign.com.br/api/v1
# Sandbox (opcional, pra testar escrita sem efeito real):
# D4SIGN_BASE_URL=https://sandbox.d4sign.com.br/api/v1
